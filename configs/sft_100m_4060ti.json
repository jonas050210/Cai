{
  "data_dir": "data/packed",
  "tokenizer_path": "artifacts/tokenizer.json",
  "out_dir": "checkpoints/sft_100m",
  "seq_len": 2048,
  "batch_size": 1,
  "grad_accum": 8,
  "max_steps": 1500,
  "lr": 5e-05,
  "min_lr": 5e-06,
  "warmup_steps": 50,
  "weight_decay": 0.01,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-08,
  "grad_clip": 1.0,
  "device": "auto",
  "precision": "bf16",
  "num_workers": 6,
  "seed": 1337,
  "resume": null,
  "init_checkpoint": "checkpoints/pretrain_100m/last.pt",
  "log_every": 5,
  "eval_every": 100,
  "save_every": 250,
  "eval_iters": 5,
  "sft_data": "data/sft/train.jsonl",
  "sft_max_len": 2048,
  "mixture": {
    "code": 0.65,
    "planning": 0.34,
    "general": 0.01
  },
  "model": {
    "vocab_size": 16000,
    "max_seq_len": 2048,
    "d_model": 768,
    "n_layers": 12,
    "n_heads": 12,
    "intermediate_size": 2112,
    "dropout": 0.1,
    "rope_theta": 10000.0,
    "tie_embeddings": true,
    "gradient_checkpointing": true
  },
  "keep_last_checkpoints": 2,
  "early_stop_patience": 3,
  "sft_val_ratio": 0.05,
  "torch_compile": false
}
