{
  "notes": "Bilingual (EN-first) 99M: GQA 4 KV heads, QK-Norm, Z-loss, 24576-token vocabulary trained on code + docs + German Wikipedia. Fresh start, no checkpoint from the English-only runs.",
  "data_dir": "data/packed",
  "tokenizer_path": "artifacts/tokenizer.json",
  "out_dir": "checkpoints/pretrain_bilingual",
  "seq_len": 2048,
  "batch_size": 2,
  "grad_accum": 8,
  "max_steps": 12000,
  "lr": 0.0002,
  "min_lr": 2e-05,
  "warmup_steps": 400,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-08,
  "grad_clip": 1.0,
  "device": "auto",
  "precision": "bf16",
  "num_workers": 8,
  "seed": 1337,
  "resume": null,
  "init_checkpoint": null,
  "log_every": 20,
  "eval_every": 250,
  "save_every": 250,
  "eval_iters": 10,
  "sft_data": null,
  "sft_max_len": 2048,
  "mixture": {
    "code": 0.5,
    "planning": 0.15,
    "general": 0.35
  },
  "model": {
    "vocab_size": 24576,
    "max_seq_len": 2048,
    "d_model": 768,
    "n_layers": 12,
    "n_heads": 12,
    "n_kv_heads": 4,
    "qk_norm": true,
    "z_loss_coef": 0.0001,
    "intermediate_size": 2112,
    "dropout": 0.0,
    "rope_theta": 10000.0,
    "tie_embeddings": true,
    "gradient_checkpointing": false
  },
  "keep_last_checkpoints": 1,
  "early_stop_patience": 6,
  "sft_val_ratio": 0.05,
  "torch_compile": true
}
